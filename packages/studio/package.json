{
  "name": "@local/dsh-card-studio-scean-test",
  "version": "1.6.2-local.w29.2d.rc3.2",
  "private": true,
  "type": "module",
  "description": "Isolated Card Studio 1.2.0 integration test copy for SCEAN",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "skills",
    "THIRD-PARTY-NOTICES.txt",
    "LICENSE",
    "COPYRIGHT",
    "LICENSE-SCOPE.md",
    "THIRD-PARTY-LICENSES.json",
    "SOURCE-AVAILABILITY.md",
    "release-source.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
